    while true do
        local nextCheckpoint = getNextCheckpoint(currentStage)
        if not nextCheckpoint then break end
        teleportToCheckpoint(nextCheckpoint)
        currentStage = currentStage + 1
        currentStageValue.Value = currentStage
        wait(0.5)
    end
end
 
