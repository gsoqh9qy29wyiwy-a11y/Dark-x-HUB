local ConfigFileName = "DarkHub_Config.json"

local function SalvarConfiguracoes()
    local sucesso = pcall(function()
        local dadosParaSalvar = {
            Tema = temaEscolhido,
            CorBordaNome = nomeCorBordaSelecionada,
            CorBordaRGB = {corBordaSelecionada.R, corBordaSelecionada.G, corBordaSelecionada.B},
            CorMensagensNome = nomeCorMensagensSelecionada,
            CorMensagensRGB = {corMensagensSelecionada.R, corMensagensSelecionada.G, corMensagensSelecionada.B},
            SincronizarCorPlayers = sincronizarCorPlayers,
            WaveSpeed = WaveSpeed,
            ColorSpread = ColorSpread,
            ConfigsProps = ConfigsProps
        }
        if writefile then
            writefile(ConfigFileName, httpService:JSONEncode(dadosParaSalvar))
        end
    end)

    if sucesso then
        SendNotification("Configurações", "Interface, Borda, Cores e Opções salvas com sucesso!", 3)
    else
        SendNotification("Configurações", "Erro ao salvar arquivo local.", 3)
    end
end

local function CarregarConfiguracoes()
    pcall(function()
        if isfile and readfile and isfile(ConfigFileName) then
            local conteudo = readfile(ConfigFileName)
            local dados = httpService:JSONDecode(conteudo)
            if dados then
                if dados.Tema then
                    temaEscolhido = dados.Tema
                    pcall(function() Window.ModifyTheme(dados.Tema) end)
                    if DropdownTemas then
                        pcall(function() DropdownTemas:Set({dados.Tema}) end)
                    end
                end

                if dados.CorBordaRGB then
                    corBordaSelecionada = Color3.new(dados.CorBordaRGB[1], dados.CorBordaRGB[2], dados.CorBordaRGB[3])
                    nomeCorBordaSelecionada = dados.CorBordaNome or nomeCorBordaSelecionada
                elseif dados.CorBordaNome and CoresBorda[dados.CorBordaNome] then
                    corBordaSelecionada = CoresBorda[dados.CorBordaNome]
                    nomeCorBordaSelecionada = dados.CorBordaNome
                end

                if DropdownCorBorda and nomeCorBordaSelecionada then
                    pcall(function() DropdownCorBorda:Set({nomeCorBordaSelecionada}) end)
                end

                task.spawn(function()
                    task.wait(0.2)
                    MudarCorBorda(corBordaSelecionada)
                    task.wait(0.8)
                    MudarCorBorda(corBordaSelecionada)
                end)

                if dados.CorMensagensRGB then
                    corMensagensSelecionada = Color3.new(dados.CorMensagensRGB[1], dados.CorMensagensRGB[2], dados.CorMensagensRGB[3])
                    nomeCorMensagensSelecionada = dados.CorMensagensNome or nomeCorMensagensSelecionada
                elseif dados.CorMensagensNome and CoresMensagens[dados.CorMensagensNome] then
                    corMensagensSelecionada = CoresMensagens[dados.CorMensagensNome]
                    nomeCorMensagensSelecionada = dados.CorMensagensNome
                end

                if DropdownCorMensagens and nomeCorMensagensSelecionada then
                    pcall(function() DropdownCorMensagens:Set({nomeCorMensagensSelecionada}) end)
                end

                if dados.SincronizarCorPlayers ~= nil then
                    sincronizarCorPlayers = dados.SincronizarCorPlayers
                end

                task.spawn(function()
                    task.wait(0.3)
                    AplicarCorNasNotificacoes()
                    InjetarFotosNaListaJogadores()
                end)

                if dados.WaveSpeed then WaveSpeed = dados.WaveSpeed end
                if dados.ColorSpread then ColorSpread = dados.ColorSpread end
                if dados.ConfigsProps then
                    for k, v in pairs(dados.ConfigsProps) do
                        if ConfigsProps[k] then
                            ConfigsProps[k] = v
                        end
                    end
                end

                SendNotification("Configurações", "Interface e Cores carregadas com sucesso!", 3)
            end
        end
    end)
end

