-- Função para obter lista de casas
local function getHouseList()
    local Tabela = {}
    local lots = workspace:FindFirstChild("001_Lots")
    if lots then
        for _, House in ipairs(lots:GetChildren()) do
            -- Filtra apenas as casas que têm dono (normalmente o nome muda para o nome do jogador)
            if House.Name ~= "For Sale" and House:IsA("Model") then
                table.insert(Tabela, House.Name)
            end
        end
    end
    if #Tabela == 0 then table.insert(Tabela, "Nenhuma casa encontrada") end
    return Tabela
end

-- Criar o Dropdown e salvar na variável HouseDropdown
HouseDropdown = CasasTab:AddDropdown({
    Name = "Selecione a Casa",
    Options = getHouseList(),
    Default = "...",
    Callback = function(Value)
        SelectHouse = Value
        if NoclipDoor then
            -- Opcional: resetar o noclip ao trocar de casa
            -- NoclipDoor:Set(false) 
