                    root.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(angulo), math.rad(angulo), 0)
                    root.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    
                    for _, p in pairs(char:GetChildren()) do 
                        if p:IsA("BasePart") then p.CanCollide = false end 
                    end
                else 
                    break 
                end
            end
            
            -- Resetar ao desligar
            if forca then forca:Destroy() end
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum:UnequipTools()
            root.Velocity = Vector3.new(0,0,0)
            root.RotVelocity = Vector3.new(0,0,0)
            root.CFrame = PosOrig
            workspace.FallenPartsDestroyHeight = -500 -- Padrão do Roblox
            FinalReset()
        end)
    else 
        _G.FlingToggle = false
        FinalReset() 
    end
end})

