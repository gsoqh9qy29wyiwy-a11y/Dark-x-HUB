local ConfigTab = Window:CreateTab("Config", 4483362458)

ConfigTab:CreateSection("Cores e Temas da Interface")

local TemasDisponiveis = {
    "Default",
    "Ocean",
    "Amethyst",
    "DarkBlue",
    "Green",
    "AmberGlow",
    "Bloom",
    "Serenity",
    "Light"
}

local temaEscolhido = "Default"

ConfigTab:CreateDropdown({
    Name = "Selecionar Tema",
    Options = TemasDisponiveis,
    CurrentOption = {"Default"},
    MultipleOptions = false,
    Flag = "DropdownTemas",
    Callback = function(opcao)
        local nome = type(opcao) == "table" and opcao[1] or opcao
        temaEscolhido = nome
    end
})

ConfigTab:CreateButton({
    Name = "Mudar Tema da Interface",
    Callback = function()
        pcall(function()
            Window.ModifyTheme(temaEscolhido)
        end)
        SendNotification("Configurações", "Tema alterado para: " .. tostring(temaEscolhido), 2)
    end
})
