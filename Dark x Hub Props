local PropsActive = false
local WaveSpeed = 0.25
local ColorSpread = 0.05

-- Configurações padrão para cada movimento
local ConfigsProps = {
    Orbita = { Speed = 2, Distance = 10, Height = 2 },
    Aura = { Speed = 2, Distance = 8, Height = 1 },
    Tremor = { Speed = 2, Distance = 10, Height = 2 },
    Caotico = { Speed = 2, Distance = 12, Height = 2 },
    Estrela = { Speed = 2, Distance = 15, Height = 15 },
    Alinhamento = { Speed = 2, Distance = 6, Height = 2 },
    Furacao = { Speed = 2, Distance = 10, Height = 4 },
    Portal = { Speed = 2, Distance = 10, Height = 4 },
    Nenhum = { Speed = 0, Distance = 0, Height = 0 }
}

-- Verifica se algum modo que necessita do PropMaker está ativo
local function AlgumModoPropAtivo()
    return (PropMovementMode ~= "Nenhum") or ModoAvancadoAtivo or ModoKillAtivo or ModoFlingAtivo or PropsActive
end

-- Gera a lista com todos os jogadores presentes no servidor
local function ObterListaNomesProps()
    local lista = {"Todos"}
    for _, jogador in ipairs(vu6:GetPlayers()) do
        table.insert(lista, jogador.Name)
    end
    return lista
end

-- Busca e atualiza a lista de props que respondem aos comandos
local function AtualizarCacheProps()
    table.clear(meusPropsCache)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("SetCurrentCFrame") then
            table.insert(meusPropsCache, obj)
        end
    end
end

