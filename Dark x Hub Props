-- FUNÇÃO GERADORA DE SEÇÕES DE MOVIMENTO
local function CriarSecaoModo(nomeModo, chaveConfig, altMin, altMax, altPadrao)
    PropsTab:CreateSection("Opção: Props " .. nomeModo)
    
    PropsTab:CreateToggle({
        Name = "Ativar " .. nomeModo,
        CurrentValue = false,
        Flag = "Toggle_" .. chaveConfig,
        Callback = function(s)
            PropMovementMode = s and chaveConfig or "Nenhum"
            if s then AtualizarCacheProps() end
        end
    })
    
    PropsTab:CreateSlider({
        Name = "Velocidade",
        Range = {1, 100},
        Increment = 1,
        Suffix = "",
        CurrentValue = math.floor(ConfigsProps[chaveConfig].Speed * 20),
        Flag = "Speed_" .. chaveConfig,
        Callback = function(v) ConfigsProps[chaveConfig].Speed = v / 20 end
    })
    
    PropsTab:CreateSlider({
        Name = "Distância",
        Range = {1, 50},
        Increment = 1,
        Suffix = "",
        CurrentValue = ConfigsProps[chaveConfig].Distance,
        Flag = "Dist_" .. chaveConfig,
        Callback = function(v) ConfigsProps[chaveConfig].Distance = v end
    })
    
    PropsTab:CreateSlider({
        Name = "Altura",
        Range = {altMin or -10, altMax or 30},
        Increment = 1,
        Suffix = "",
        CurrentValue = altPadrao or ConfigsProps[chaveConfig].Height,
        Flag = "Height_" .. chaveConfig,
        Callback = function(v) ConfigsProps[chaveConfig].Height = v end
