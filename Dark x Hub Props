local CoordenadasFling = Vector3.new(-881615241216, 881615241216, -881615241216)

-- Tabelas de estado e controle dos Props
local meusPropsCache = {}
local PropMovementMode = "Nenhum"
local ModoAvancadoAtivo = false
local ModoKillAtivo = false
local ModoFlingAtivo = false
