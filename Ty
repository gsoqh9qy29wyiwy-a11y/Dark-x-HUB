ChildTab:AddButton({
    Name = "Enviar criança",
    Callback = function()
        if not chasingplayer then
            warn("Nenhum jogador selecionado!")
            return 
        end
        
        -- Spawn da Criança
        local args = { [1] = "CharacterFollowSpawnPlayer", [2] = "BabyBoy" }
        pcall(function()
            game:GetService("ReplicatedStorage").RE:FindFirstChild("1Bab1yFollo1w"):FireServer(unpack(args))
        end)

        task.wait(0.3)

        local target = chasingplayer
        local targetPlr = game.Players:FindFirstChild(target)
        
        if targetPlr and targetPlr.Character and vu7.Character and vu7.Character:FindFirstChild("FollowCharacter") then
            local followChar = vu7.Character.FollowCharacter
            followChar.Parent = targetPlr.Character
            
            -- Loop de Movimento FE
            if getgenv().FollowLoop then getgenv().FollowLoop:Disconnect() end
            getgenv().FollowLoop = vu10.Heartbeat:Connect(function()
                if followChar and followChar:FindFirstChild("Torso") and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = targetPlr.Character.HumanoidRootPart
                    followChar.Torso.BodyPosition.Position = hrp.Position - (hrp.CFrame.LookVector * 3)
                    followChar.Torso.BodyGyro.CFrame = hrp.CFrame
                else
                    getgenv().FollowLoop:Disconnect()
                end
            end)
        end
    end
})

ChildTab:AddButton({
    Name = "Retornar criança",
    Callback = function() 
        if getgenv().FollowLoop then
            getgenv().FollowLoop:Disconnect()
            getgenv().FollowLoop = nil
        end
        pcall(function()
            game:GetService("ReplicatedStorage").RE:FindFirstChild("1Bab1yFollo1w"):FireServer("DeleteFollowCharacter")
            task.wait(0.1)
            game:GetService("ReplicatedStorage").RE:FindFirstChild("1Bab1yFollo1w"):FireServer("CharacterFollowSpawnPlayer", "BabyBoy")
        end)
    end
})

