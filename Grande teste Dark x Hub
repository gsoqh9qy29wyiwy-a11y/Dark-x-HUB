task.spawn(function()
    local angle, tempoGeral = 0, 0
    while true do
        local dt = task.wait(0.03)
        if (PropMovementMode == "Nenhum" and not ModoAvancadoAtivo and not ModoKillAtivo and not ModoFlingAtivo) or #meusPropsCache == 0 then
            continue
        end

        local lista = {}
        if selecionarTodosProps then
            for _, p in ipairs(vu6:GetPlayers()) do
                if p ~= vu7 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(lista, p)
                end
            end
        else
            if jogadorSelecionadoProp and jogadorSelecionadoProp.Character and jogadorSelecionadoProp.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(lista, jogadorSelecionadoProp)
            end
        end

        if #lista == 0 then continue end

        local cfg = ConfigsProps[PropMovementMode]
        local speedVal = cfg and cfg.Speed or 2
        angle = angle + (dt * speedVal)
        tempoGeral = tempoGeral + dt * (speedVal * 2)
        local total = #meusPropsCache

        local myChar = vu7.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myCF = myRoot and myRoot.CFrame or CFrame.new()

        for i, prop in ipairs(meusPropsCache) do
            local remote = prop:FindFirstChild("SetCurrentCFrame")
            if remote then
                local pDono = lista[((i - 1) % #lista) + 1]
                if pDono and pDono.Character and pDono.Character:FindFirstChild("HumanoidRootPart") then
                    local root = pDono.Character.HumanoidRootPart
                    local rCF = root.CFrame
                    local humAlvo = pDono.Character:FindFirstChildWhichIsA("Humanoid")
                    local sitCF = rCF * CFrame.new(0, -0.6, 0)

                    -- 1. MODO FLING
                    if ModoFlingAtivo then
                        if humAlvo and (humAlvo.SeatPart or humAlvo.Sit) then
                            task.spawn(function()
                                pcall(remote.InvokeServer, remote, CFrame.new(CoordenadasFling))
                            end)
                        else
                            task.spawn(function()
                                pcall(remote.InvokeServer, remote, sitCF)
                            end)
                        end

                    -- 2. MODO KILL (VOID)
                    elseif ModoKillAtivo then
                        if humAlvo and (humAlvo.SeatPart or humAlvo.Sit) then
                            task.spawn(function()
                                pcall(remote.InvokeServer, remote, CFrame.new(rCF.Position.X, -500, rCF.Position.Z))
                            end)
                        else
                            task.spawn(function()
                                pcall(remote.InvokeServer, remote, sitCF)
                            end)
                        end

                    -- 3. MODO BRING
                    elseif ModoAvancadoAtivo then
                        if humAlvo and (humAlvo.SeatPart or humAlvo.Sit) then
                            task.spawn(function() 
                                pcall(remote.InvokeServer, remote, myCF * CFrame.new(0, 0, -3)) 
                            end)
                        else
                            task.spawn(function() 
                                pcall(remote.InvokeServer, remote, sitCF) 
                            end)
                        end

                    -- 4. MODOS DE MOVIMENTO
                    elseif cfg and PropMovementMode ~= "Nenhum" then
                        local tPos = rCF.Position
                        local olharPara = rCF.Position
                        local spacing = (math.pi * 2) / math.max(total, 1)
                        local fAngle = angle + (i * spacing)

                        if PropMovementMode == "Orbita" then
                            tPos = rCF.Position + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance)
                        elseif PropMovementMode == "Aura" then
                            local o = math.sin(tempoGeral * 3 + i) * 1.5
                            tPos = rCF.Position + Vector3.new(math.cos(fAngle * 1.5) * (cfg.Distance + (o * 0.2)), cfg.Height + o, math.sin(fAngle * 1.5) * (cfg.Distance + (o * 0.2)))
                            olharPara = rCF.Position + Vector3.new(0, o, 0)
                        elseif PropMovementMode == "Tremor" then
                            tPos = rCF.Position + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance) + Vector3.new(math.sin(tick() * 50 + i) * 0.8, math.cos(tick() * 55 + i) * 0.8, math.sin(tick() * 60 + i) * 0.8)
                        elseif PropMovementMode == "Caotico" then
                            tPos = rCF.Position + Vector3.new(math.cos(fAngle) * cfg.Distance, cfg.Height, math.sin(fAngle) * cfg.Distance) + Vector3.new(math.sin(tempoGeral + (i * 2)) * (cfg.Distance * 0.5), math.cos(tempoGeral * 1.8 + i) * 4, math.sin(tempoGeral * 1.3 + i) * (cfg.Distance * 0.5))
                            olharPara = tPos + Vector3.new(math.sin(tempoGeral * 5), math.cos(tempoGeral * 5), math.sin(tempoGeral * 3))
                        elseif PropMovementMode == "Estrela" then
                            local e = cfg.Distance + (math.sin(tempoGeral * 2.5 + i) * (cfg.Distance * 0.4))
                            tPos = rCF.Position + Vector3.new(math.cos(fAngle) * e, cfg.Height + (math.cos(fAngle) * 2), math.sin(fAngle) * e)
                            olharPara = rCF.Position + Vector3.new(0, cfg.Height, 0)
                        elseif PropMovementMode == "Alinhamento" then
                            tPos = rCF.Position + (rCF.LookVector * (-5 - (i * cfg.Distance))) + Vector3.new(0, cfg.Height + (math.sin(tempoGeral + i) * 0.5), 0)
                            olharPara = tPos - (rCF.LookVector * 100)
                        elseif PropMovementMode == "Furacao" then
                            local s = ((tempoGeral + (i * 2)) % 10) - 3
                            local pFrente = rCF.Position + (rCF.LookVector * 5)
                            tPos = pFrente + Vector3.new(math.cos(fAngle * 1.5) * (cfg.Distance * (1 - (s / 15))), cfg.Height + s, math.sin(fAngle * 1.5) * (cfg.Distance * (1 - (s / 15))))
                            olharPara = pFrente + Vector3.new(0, 10, 0)
                        elseif PropMovementMode == "Portal" then
                            local rp = cfg.Distance * 0.7
                            local pFrente = rCF.Position + (rCF.LookVector * 5)
                            tPos = (rCF * CFrame.new(0, cfg.Height + (math.sin(fAngle) * rp), -5)).Position + (rCF.RightVector * (math.cos(fAngle) * rp))
                            olharPara = pFrente + (rCF.LookVector * 20)
                        end
                        task.spawn(function() pcall(remote.InvokeServer, remote, CFrame.lookAt(tPos, olharPara)) end)
                    end
                end
            end
        end
    end
end)

