            pcall(function()
                vu8:WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer("PickingTools", "PropMaker")
            end)
            task.wait(0.3)

            local vim = game:GetService("VirtualInputManager")

            for i = 1, 15 do
                local char = vu7.Character
                local mochila = vu7:FindFirstChild("Backpack")
                local propMaker = (char and char:FindFirstChild("PropMaker")) or (mochila and mochila:FindFirstChild("PropMaker"))
                
                if propMaker and char and propMaker.Parent ~= char then
                    propMaker.Parent = char
                    task.wait(0.15)
                end

                pcall(function()
                    for _, obj in ipairs(vu7.PlayerGui:GetDescendants()) do
                        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                            local n = obj.Name:lower()
                            local t = (obj:IsA("TextButton") and obj.Text:lower()) or ""
                            if n:find("sofa") or n:find("couch") or t:find("sofa") or t:find("couch") then
                                if getconnections then
                                    for _, c in ipairs(getconnections(obj.MouseButton1Click)) do c:Fire() end
                                    for _, c in ipairs(getconnections(obj.Activated)) do c:Fire() end
                                end
                                pcall(function() obj.Activated:Fire() end)
                                break
                            end
                        end
                    end
                end)

                task.wait(0.08)

                if propMaker then
                    pcall(function() propMaker:Activate() end)
                end
                task.wait(0.05)

                pcall(function()
                    local cx = vuCam.ViewportSize.X / 2
                    local cy = vuCam.ViewportSize.Y / 2
                    vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.03)
                    vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end)

                pcall(function()
                    vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.03)
                    vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end)

                task.wait(0.15)
            end

            task.wait(0.5)

            AtualizarCacheProps()
            SendNotification("PropMaker (Teste)", "15 Sofás colocados! Total: " .. #meusPropsCache, 3)
        end)
    end
})

