local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 5)

local function wearItem(id, remotesList)
    if not tonumber(id) or not RemotesFolder then return end
    for _, nome in ipairs(remotesList) do
        local remote = RemotesFolder:FindFirstChild(nome)
        if remote then
            remote:InvokeServer(tonumber(id))
            task.wait(0.2)
            return true
        end
    end
end

local function safeFire(nome, ...)
    if not RemotesFolder then return end
    local remote = RemotesFolder:FindFirstChild(nome)
    if remote then
        remote:FireServer(...)
        task.wait(0.2)
    end
end

local function aplicarPackCompleto(idsDeRoupas, corpoParts, corHex)
    if not RemotesFolder then return end

    for _, id in ipairs(idsDeRoupas) do
        local remoteWear = RemotesFolder:FindFirstChild("Wear")
        if remoteWear then
            remoteWear:InvokeServer(id)
            task.wait(0.3)
        end
    end

    if corpoParts and #corpoParts > 0 then
        local remoteBody = RemotesFolder:FindFirstChild("ChangeCharacterBody")
        if remoteBody then
            local argsBody = {
                [1] = {
                    corpoParts[1] or 0,
                    corpoParts[2] or 0,
                    corpoParts[3] or 0,
                    corpoParts[4] or 0,
                    corpoParts[5] or 0,
                    corpoParts[6] or 0
                }
            }
            remoteBody:InvokeServer(unpack(argsBody))
            task.wait(0.3)
        end
    end

    if corHex then
        local remoteColor = RemotesFolder:FindFirstChild("ChangeBodyColor")
        if remoteColor then remoteColor:FireServer(corHex) end
    end
    
    ModernNotify("Pack Equipado", "Conjunto aplicado com sucesso!", 3, "success")
end

