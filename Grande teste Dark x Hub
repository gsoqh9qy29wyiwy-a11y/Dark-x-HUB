-- FUNÇÃO GERADORA DE SEÇÕES DE MOVIMENTO
local function CriarSecaoModo(nomeModo, chaveConfig, altMin, altMax, altPadrao)
    PropsTab:AddSection({"Opção: Props " .. nomeModo})
    
    PropsTab:AddToggle({
        Name = "Ativar " .. nomeModo,
        Default = false,
        Callback = function(s)
            PropMovementMode = s and chaveConfig or "Nenhum"
            if s then AtualizarCacheProps() end
        end
    })
    
    PropsTab:AddSlider({
        Name = "Velocidade",
        Min = 1,
        Max = 100,
        Increase = 1,
        Default = math.floor(ConfigsProps[chaveConfig].Speed * 20),
        Callback = function(v) ConfigsProps[chaveConfig].Speed = v / 20 end
    })
    
    PropsTab:AddSlider({
        Name = "Distância",
        Min = 1,
        Max = 50,
        Increase = 1,
        Default = ConfigsProps[chaveConfig].Distance,
        Callback = function(v) ConfigsProps[chaveConfig].Distance = v end
    })
    
    PropsTab:AddSlider({
        Name = "Altura",
        Min = altMin or -10,
        Max = altMax or 30,
        Increase = 1,
        Default = altPadrao or ConfigsProps[chaveConfig].Height,
        Callback = function(v) ConfigsProps[chaveConfig].Height = v end
    })
end

