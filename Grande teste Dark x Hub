-- Função: Criar Jaula (ForceField)
local function CreateJail(targetPlr)
    if not targetPlr or Jajail[targetPlr] then return end
    local char = targetPlr.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local HRP = char.HumanoidRootPart
        local cageSize = Vector3.new(10, 10, 10)
        local cageModel = Instance.new("Model")
        cageModel.Name = "JaulaAdmin_" .. targetPlr.Name
        cageModel.Parent = workspace

        local function createWall(size, offset)
            local wall = Instance.new("Part")
            wall.Size = size
            wall.Anchored = true
            wall.CanCollide = true
            wall.Transparency = 0.3
            wall.Color = Color3.fromRGB(75, 0, 130)
            wall.Material = Enum.Material.ForceField
            wall.CFrame = HRP.CFrame * offset
            wall.Parent = cageModel

            local box = Instance.new("SelectionBox")
            box.Color3 = Color3.fromRGB(147, 112, 219)
            box.Adornee = wall
            box.Parent = wall
        end

        createWall(Vector3.new(cageSize.X, 0.5, cageSize.Z), CFrame.new(0, -cageSize.Y/2, 0))
        createWall(Vector3.new(cageSize.X, 0.5, cageSize.Z), CFrame.new(0, cageSize.Y/2, 0))
        createWall(Vector3.new(cageSize.X, cageSize.Y, 0.5), CFrame.new(0, 0, -cageSize.Z/2))
        createWall(Vector3.new(cageSize.X, cageSize.Y, 0.5), CFrame.new(0, 0, cageSize.Z/2))
        createWall(Vector3.new(0.5, cageSize.Y, cageSize.Z), CFrame.new(cageSize.X/2, 0, 0))
        createWall(Vector3.new(0.5, cageSize.Y, cageSize.Z), CFrame.new(-cageSize.X/2, 0, 0))

        Jajail[targetPlr] = cageModel
    end
end

