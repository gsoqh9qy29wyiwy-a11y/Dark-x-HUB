        ModoAvancadoAtivo = state
        if not state then return end
        task.spawn(function()
            local alguemSentou = false
            while ModoAvancadoAtivo and not alguemSentou do
                local alvos = {}
                if selecionarTodosProps then
                    for _, p in ipairs(vu6:GetPlayers()) do
                        if p ~= vu7 and p.Character then table.insert(alvos, p) end
                    end
                elseif jogadorSelecionadoProp and jogadorSelecionadoProp.Character then
                    table.insert(alvos, jogadorSelecionadoProp)
                end
                for _, alvo in ipairs(alvos) do
                    local hum = alvo.Character:FindFirstChildWhichIsA("Humanoid")
                    if hum and (hum.SeatPart or hum.Sit) then
                        alguemSentou = true
                        break
                    end
                end
                task.wait(0.1)
            end
            if alguemSentou and ModoAvancadoAtivo then
                pcall(function()
                    vu8:WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer("PickingTools", "PropMaker")
                end)
            end
        end)
    end
})

