local function AplicarFisicaFling(ball)
    if not ball or not ball:IsA("BasePart") then return end
    pcall(function()
        ball.CanCollide = false
        ball.Massless = true
        ball.CustomPhysicalProperties = PhysicalProperties.new(10000, 100, 100, 100, 100)

        local bv = ball:FindFirstChild("FlingPower")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FlingPower"
            bv.Velocity = Vector3.new(9e9, 9e9, 9e9)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 9e900
            bv.Parent = ball
        else
            bv.Velocity = Vector3.new(9e9, 9e9, 9e9)
        end

        local bav = ball:FindFirstChild("FlingSpin")
        if not bav then
            bav = Instance.new("BodyAngularVelocity")
            bav.Name = "FlingSpin"
            bav.AngularVelocity = Vector3.new(9e9, 9e9, 9e9)
            bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bav.P = 9e900
            bav.Parent = ball
        else
            bav.AngularVelocity = Vector3.new(9e9, 9e9, 9e9)
        end

        ball.AssemblyLinearVelocity = Vector3.new(9e9, 9e9, 9e9)
        ball.AssemblyAngularVelocity = Vector3.new(9e9, 9e9, 9e9)
        ball:SetNetworkOwner(nil)
    end)
end

local function LimparFisicaFling(ball)
    if not ball or not ball:IsA("BasePart") then return end
    pcall(function()
        local bv = ball:FindFirstChild("FlingPower")
        if bv then bv:Destroy() end
        local bav = ball:FindFirstChild("FlingSpin")
        if bav then bav:Destroy() end
        ball.AssemblyLinearVelocity = Vector3.zero
        ball.AssemblyAngularVelocity = Vector3.zero
    end)
end

