Tab3:AddButton({
    Name = "Copiar Avatar",
    Description = "Clona roupas, corpo e bio do jogador selecionado",
    Callback = function()
        if not TargetClone then
            ModernNotify("Atenção", "Selecione um jogador na lista primeiro!", 3, "warn")
            return
        end

        local TPlayer = Players:FindFirstChild(TargetClone)
        if not (TPlayer and TPlayer.Character) then
            ModernNotify("Erro", "Jogador não encontrado ou sem personagem.", 3, "warn")
            return
        end

        ModernNotify("Copiando Avatar...", "Clonando itens de @" .. TargetClone, 3, "info")

        local LChar = LocalPlayer.Character
        local LHumanoid = LChar and LChar:FindFirstChildOfClass("Humanoid")
        local THumanoid = TPlayer.Character:FindFirstChildOfClass("Humanoid")

        if LHumanoid and THumanoid then
            local PDesc = THumanoid:GetAppliedDescription()
            local remoteBody = RemotesFolder and RemotesFolder:FindFirstChild("ChangeCharacterBody")
            
            if remoteBody then
                local argsBody = {
                    [1] = {
                        PDesc.Torso or 0,
                        PDesc.RightArm or 0,
                        PDesc.LeftArm or 0,
                        PDesc.RightLeg or 0,
                        PDesc.LeftLeg or 0,
                        PDesc.Head or 0
                    }
                }
                remoteBody:InvokeServer(unpack(argsBody))
                task.wait(0.3)
            end

            wearItem(PDesc.Shirt, {"WearShirt", "WearOutfit", "Wear"})
            wearItem(PDesc.Pants, {"WearPants", "WearOutfit", "Wear"})
            wearItem(PDesc.Face, {"WearFace", "Wear"})

            for _, acc in ipairs(PDesc:GetAccessories(true)) do
                wearItem(acc.AssetId, {"WearAccessory", "Wear"})
            end

            wearItem(PDesc.IdleAnimation, {"WearAnimation", "Wear"})

            local SkinColor = TPlayer.Character:FindFirstChild("Body Colors")
            if SkinColor then
                safeFire("ChangeBodyColor", tostring(SkinColor.HeadColor))
            end

            local Bag = TPlayer:FindFirstChild("PlayersBag")
            if Bag then
                local function sendText(childName, remoteKey)
                    local c = Bag:FindFirstChild(childName)
                    if c and c.Value ~= "" then
                        safeFire("RPNameText", remoteKey, c.Value)
                    end
                end

                sendText("RPName", "RolePlayName")
                sendText("RPBio", "RolePlayBio")

                if Bag:FindFirstChild("RPNameColor") then
                    safeFire("RPNameColor", "PickingRPNameColor", Bag.RPNameColor.Value)
                end
                if Bag:FindFirstChild("RPBioColor") then
                    safeFire("RPNameColor", "PickingRPBioColor", Bag.RPBioColor.Value)
                end
            end

            ModernNotify("Sucesso!", "Avatar de @" .. TargetClone .. " clonado!", 4, "success")
        end
    end
})

