local function getHouseList()
    local Tabela = {}
    local lots = Workspace:FindFirstChild("001_Lots")
    if lots then
        for _, House in ipairs(lots:GetChildren()) do
            if House.Name ~= "For Sale" and House:IsA("Model") then
                table.insert(Tabela, House.Name)
            end
        end
    end
    return Tabela
end

local function getSelectedHouse()
    if SelectHouse and Workspace:FindFirstChild("001_Lots") then
        return Workspace["001_Lots"]:FindFirstChild(tostring(SelectHouse))
    end
    return nil
end

local function getHouseRemote()
    local re = ReplicatedStorage:FindFirstChild("RE")
    return re and re:FindFirstChild("1Player1sHous1e")
end

local function getHouseOwnerPlayer()
    local house = getSelectedHouse()
    if house then
        local ownerVal = house:FindFirstChild("Owner") or house:FindFirstChild("HouseOwner")
        if ownerVal and ownerVal.Value then
            local ownerName = tostring(ownerVal.Value)
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Name == ownerName or player.DisplayName == ownerName then
                    return player
                end
            end
        end
    end
    return nil
end

local function removerESP(container)
    if container then
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name == "SafeESP" then
                obj:Destroy()
            end
        end
    end
end

